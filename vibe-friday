#!/usr/bin/env bash

set -Eeuo pipefail

readonly project_name="vibe-friday"
readonly project_url="http://vibe-friday.localhost:8791"
readonly compose=(docker compose --project-name "$project_name")

require_docker() {
  if ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1; then
    echo "Docker with the Compose plugin is required." >&2
    exit 1
  fi
}

show_usage() {
  cat <<'USAGE'
Usage: ./vibe-friday <command>

Commands:
  start    Build and start the project
  stop     Stop the project
  verify   Run formatting, linting, analysis, tests and build checks
  logs     Follow application logs
  shell    Open a shell in the application container
USAGE
}

require_docker

start_app() {
  if [[ "${VIBE_FRIDAY_SKIP_IMAGE_BUILD:-}" == "1" ]]; then
    "${compose[@]}" up --detach --wait app
  else
    "${compose[@]}" up --build --detach --wait app
  fi
}

case "${1:-}" in
  start)
    start_app
    echo "Vibe Friday is ready at $project_url"
    ;;
  stop)
    "${compose[@]}" down
    ;;
  verify)
    start_app
    "${compose[@]}" exec -T app pnpm verify
    ;;
  logs)
    "${compose[@]}" logs --follow app
    ;;
  shell)
    "${compose[@]}" exec app sh
    ;;
  *)
    show_usage
    exit 1
    ;;
esac
