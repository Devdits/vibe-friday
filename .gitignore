/src/app/favicon.ico

# production
/build

# misc
.DS_Store
*.pem

# IDEs
.idea/
.vscode/
.fleet/
.zed/
*.code-workspace

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Personal workshop prompt history
.vibe-friday/
